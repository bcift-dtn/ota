<nav class="main-nav">
  <!-- A placeholder for now -->
  <p><a href="/">OTA</a></p>

  <!-- Navigation Links -->
  <ul>
    <li><a href="#">ABOUT US</a></li>
    <li><a href="#"> PROMO</a></li>
    <li><a href="#">BLOG</a></li>
    <li><a href="#">CONTACT US</a></li>
    <li><a href="#">T&C</a></li>
  </ul>

  <!-- Login Button / Profile -->
  <% if (user) { %>
    <div class="profile-wrapper">
      <button class="profile-btn" id="profileBtn"><i data-lucide="user"></i> <%= user.fullName %></button>
      <div class="profile-dropdown-container hidden" id="profileDropdownContainer">
        <p>Profile</p>
        <ul class="profile-dropdown" id="profileDropdown">
          <li><a href="#"><i data-lucide="user"></i> Personal Info</a></li>
          <li><a href="#"><i data-lucide="lock-keyhole"></i> Account and Security</a></li>
          <li><a href="#"><i data-lucide="tickets"></i> My Points</a></li>
          <li><a href="#"><i data-lucide="receipt-text"></i> My Orders</a></li>
          <li class="logout">
            <form action="/auth/logout" method="post">
              <button type="submit">
                <i data-lucide="log-out"></i> Log Out
              </button>
            </form>
          </li>
        </ul>
      </div>
    </div>
  <% } else { %> 
    <button class="nav-login-btn" id="navLoginBtn">Login</button>
  <% } %>
</nav>

<script src="https://unpkg.com/lucide@latest"></script>
