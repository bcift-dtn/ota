<!-- Login Modal -->
<div class="modal-overlay hidden" id="modalOverlay">
  <div class="login-modal" id="loginModal">
    <span id="closeModal" class="close-modal">x</span>
    <h3>SIGN IN</h3>

    <form id="loginModalForm">
      <div class="email">
        <p id="loginStatusText" class="smaller-label warning-text"></p>
        <label for="loginEmailInput">Email:</label>
        <input type="email" class="email-input" id="loginEmailInput" name="email" placeholder="Enter Email" autocomplete="email" required>
      </div>

      <div class="password">
        <label for="loginPasswordInput">Password:</label>
        <div>
          <input type="password" class="password-input" id="loginPasswordInput" name="password" placeholder="Enter Password" required>
          <button type="button" class="toggle-password" data-target="loginPasswordInput">
            <i data-lucide="eye-closed"></i>
          </button>
        </div>
      </div>

      <div class="login-options-row">
        <label class="remember-me" for="rememberMe">
          <input type="checkbox" id="rememberMe" name="rememberMe">
          <span class="custom-checkbox"></span>
          Remember me
        </label>
        <a href="/auth/forgot-password" class="forgot-password-link">Forgot Password?</a>
      </div>

      <button type="submit" class="submit-login-btn" id="submitLoginBtn">
        Sign In
      </button>

      <div class="modal-divider">
        <span>or</span>
      </div>

      <div class="oauth-buttons">
        <a href="/auth/google" class="oauth-btn google-btn">
          <img src="/images/icons/google-icon.svg" alt="Google" width="24">
          Sign in with Google
        </a>

        <a href="/auth/apple" class="oauth-btn apple-btn">
          <img src="/images/icons/apple-icon.svg" alt="Apple" width="24">
          Sign in with Apple
        </a>
      </div>
    </form>

    <div class="modal-optional-option">
      <p>Don't have an account? <a href="/auth/register">Sign Up</a></p>
    </div>
  </div>
</div>

<script src="/js/modal.js"></script>