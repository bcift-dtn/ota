<!-- Login Modal -->
<div class="modal-overlay hidden" id="modalOverlay">
  <div class="login-modal" id="loginModal">
    <span id="closeModal">x</span>
    <h3>SIGN IN</h3>

    <form id="loginModalForm">
      <div class="email">
        <p id="loginStatusText" class="smaller-label warning-text"></p>
        <label for="emailInput">Email:</label>
        <input type="email" class="email-input" id="emailInput" name="email" placeholder="Enter Email" required>
      </div>

      <div class="password">
        <label for="passwordInput">Password:</label>
        <div>
          <input type="password" class="password-input" id="passwordInput" name="password" placeholder="Enter Password" required>
          <button type="button" class="toggle-password" data-target="passwordInput">
            <i data-lucide="eye-closed"></i>
          </button>
        </div>
      </div>

      <button type="submit" class="submit-login-btn" id="submitLoginBtn">
        SIGN IN
      </button>
    </form>

    <div class="modal-optional-option">
      <a href="#">Forgot Password?</a>
      <p>Don't have an account? <a href="/auth/register">Sign Up</a></p>
    </div>
  </div>
</div>