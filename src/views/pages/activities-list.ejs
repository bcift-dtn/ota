<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activities - MEGATERRA</title>
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/components/search.css">
  <link rel="stylesheet" href="/css/pages/activities-list.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
</head>

<body>
  <%- include('../partials/navbar') %>
    <main>
      <section class="list-hero-banner hero-activities-list">
        <img src="/images/hero-banners/ranoh-hero.webp" alt="Activities Hero Banner">
        <h1>ACTIVITIES</h1>
      </section>

      <section class="search-component">
        <div class="search-form" data-form="activities">
          <form action="/products/activities" method="GET">
            <div class="search-component-left">
              <div class="search-input-wrapper">
                <label for="activitiesCheckInDate" class="label-text">Check In Date</label>
                <input type="date" class="activities-check-in-date date-input" id="activitiesCheckInDate" name="activitiesCheckInDate"
                  value="<%= searchParams.activitiesCheckInDate %>" placeholder="Select date..." required>
              </div>
            </div>

            <button type="submit" class="submit-search-btn" id="submitCarRentalSearchBtn">Search</button>
          </form>
        </div>
      </section>

      <%- include('../partials/breadcrumb', { breadcrumbs }) %>

        <section class="product-list">
          <div class="product-list-container">
            <% products.forEach(product=> { %>
              <div class="product-card-horizontal" data-product-id="<%= product.id %>">
                <div class="product-card-top">
                  <div class="product-card-image">
                    <% if (product.image_url) { %>
                      <img src="<%= product.image_url %>" alt="<%= product.title %>">
                      <% } else { %>
                        <div class="product-card-image-placeholder"></div>
                        <% } %>
                  </div>
                  <div class="product-card-info">
                    <div class="product-card-info-split">
                      <div class="product-card-info-left">
                        <h2>
                          <%= product.title %>
                        </h2>
                        <div>
                          <% product.amenities.forEach(amenity=> { %>
                            <p class="smaller-label label-text"><i data-lucide="<%= amenity.icon_lucide %>"></i> <%= amenity.name %>
                            </p>
                            <% }) %>
                        </div>
                      </div>
                      <div class="product-card-info-right">
                        <div>
                          <p>Start from</p>
                          <div class="product-card-price-wrapper">
                            <p class="product-card-price">IDR <%= product.formatted_starting_price %>
                            </p>
                          </div>
                        </div>
                        <button class="detail-btn">Detail</button>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="package-dropdown hidden">
                  <div class="package-dropdown-header">
                    <p class="smaller-label">SELECT TRANSFER PACKAGE</p>
                    <p class="package-error smaller-label warning-text hidden">Please select a package first.</p>
                  </div>
                  <div class="package-list">
                    <% product.packages.forEach ((package, index)=> { %>
                      <div class="package-option <%= index === 0 ? 'active' : '' %>" data-package-id="<%= package.id %>"
                        data-price="<%= package.normal_price%>">
                        <div class="package-option-info">
                          <p class="package-name bigger-label <%= index === 0 ? 'active-text' : '' %>">
                            <%= package.name %>
                          </p>
                          <p class="package-description smaller-label">
                            <%= package.description %>
                          </p>
                        </div>
                        <p class="package-price bigger-label <%= index === 0 ? 'active-text' : '' %>">IDR <%=
                            package.formatted_price %>
                        </p>
                      </div>
                      <% }) %>
                        <button class="confirm-selection-btn">CONFIRM SELECTION</button>
                  </div>
                </div>
              </div>
              <% }) %>

              <% if (products.length===0) { %>
                <div class="empty-state">
                  <i data-lucide="frown"></i>
                  <h2>No Activities Found</h2>
                  <p>Try adjusting your filters or date to see more results.</p>
                </div>
              <% } %>

              <% if (totalPages > 1) { %> 
                <% 
                  let startPage = 1;
                  let endPage = totalPages;

                  if (totalPages > 5) {
                    if (currentPage <= 3) {
                      startPage = 1;
                      endPage = 5;
                    } else if (currentPage >= totalPages - 2) {
                      startPage = totalPages - 4;
                      endPage = totalPages; 
                    } else {
                      startPage = currentPage - 2;
                      endPage = currentPage + 2;
                    }
                  }

                  let filterQuery = '';
                  if (searchParams.activitiesCheckInDate) filterQuery += `&activitiesCheckInDate=${searchParams.activitiesCheckInDate}`;
                %>

                <div class="pagination-wrapper">
                  <% if (currentPage > 1)  { %>
                    <a href="/products/activities?page=1<%= filterQuery %>" class="page-text-btn page-first-btn">First Page</a>
                    <a href="/products/activities?page=<%= currentPage - 1 %><%= filterQuery %>" class="page-icon-btn">&lt;</a>
                  <% } %>

                  <% for (let i = startPage; i <= endPage; i++) { %> 
                    <a href="/products/activities?page=<%= i %><%= filterQuery %>" class="page-btn <%= currentPage === i ? 'active' : '' %>">
                      <%= i %>
                    </a>
                  <% } %>

                  <% if (currentPage < totalPages) { %> 
                    <a href="/products/activities?page=<%= currentPage + 1 %><%= filterQuery %>" class="page-icon-btn">&gt;</a>
                    <a href="/products/activities?page=<%= totalPages %><%= filterQuery %>" class="page-text-btn page-last-btn">Last Page</a>
                  <% } %>
                </div>
              <% } %>
          </div>
        </section>
    </main>

    <%- include('../partials/footer') %>

    <%- include('../partials/loginModal') %>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="/js/activities-list.js"></script>
</body>

</html>