                        <p class="smaller-label">per night/room</p>
                      </div>

                      <button>Book Now</button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="swiper-slide">
                <div class="hotel-card">
                  <div class="card-image"></div>
                  <div class="card-detail">
                    <div class="card-review-rating">
                      <!-- Star icon, rating, (total review) --> 
                    </div>
                    <h3>Hotel Name</h3>
                    <div class="card-location-rating">
                      <p>
                        <!-- Location pin --> Location
                      </p>
                      <p>★★★★☆</p>
                    </div>
                    <div class="card-price-book-wrapper">
                      <div class="card-price-wrapper">
                        <p class="smaller-label">Starts from</p>
                        <p>IDR </p>
                        <p class="smaller-label">per night/room</p>
                      </div>

                      <button>Book Now</button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="swiper-slide">
                <div class="hotel-card">
                  <div class="card-image"></div>
                  <div class="card-detail">
                    <div class="card-review-rating">
                      <!-- Star icon, rating, (total review) --> 
                    </div>
                    <h3>Hotel Name</h3>
                    <div class="card-location-rating">
                      <p>
                        <!-- Location pin --> Location
                      </p>
                      <p>★★★★☆</p>
                    </div>
                    <div class="card-price-book-wrapper">
                      <div class="card-price-wrapper">
                        <p class="smaller-label">Starts from</p>
                        <p>IDR </p>
                        <p class="smaller-label">per night/room</p>
                      </div>

                      <button>Book Now</button>
                    </div>
                  </div>
                </div>
              </div>

              <div class="swiper-slide">
                <div class="hotel-card">
                  <div class="card-image"></div>
                  <div class="card-detail">
                    <div class="card-review-rating">
                      <!-- Star icon, rating, (total review) --> 
                    </div>
                    <h3>Hotel Name</h3>
                    <div class="card-location-rating">
                      <p>
                        <!-- Location pin --> Location
                      </p>
                      <p>★★★★☆</p>
                    </div>
                    <div class="card-price-book-wrapper">
                      <div class="card-price-wrapper">
                        <p class="smaller-label">Starts from</p>
                        <p>IDR </p>
                        <p class="smaller-label">per night/room</p>
                      </div>

                      <button>Book Now</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="hotels-btn-prev swiper-button-prev"></div>
            <div class="hotels-btn-next swiper-button-next"></div>
          </div>
        </div>
      </section>

      <section class="top-destinations">
        <div class="section-container">
          <div class="section-header">
            <h2>Top Destination</h2>
            <p class="smaller-label">Lorem ipsum dolor sit amet, consectetur adipisicing elit. Ratione aliquam veniam temporibus aperiam hic, incidunt repellendus nam ab, accusantium eaque maxime a. Sapiente doloremque assumenda adipisci commodi autem, libero rem.</p>
          </div>

          <div class="destinations-grid">
            <div class="destination-card">
              <!-- Will have image in it -->
               <p>INDONESIA</p>
            </div>

            <div class="destination-card">
              <!-- Will have image in it -->
               <p>SINGAPORE</p>
            </div>

            <div class="destination-card">
              <!-- Will have image in it -->
               <p>MALAYSIA</p>
            </div>
          </div>
        </div>
      </section>

      <section class="our-brand">
        <div class="section-container">
          <div class="section-header">
            <h2>Our Brand</h2>
            <p class="smaller-label">
              Lorem ipsum dolor sit, amet consectetur adipisicing 
              elit. Exercitationem architecto ratione delectus 
              provident quos repellat harum, ea rerum nisi neque 
              consequuntur fuga nulla deserunt, distinctio non 
              corporis quod iure voluptatem.
            </p>
          </div>

          <div class="our-brand-grid">
            <img src="/images/logos/majestic-ferry-logo.webp" alt="Logo of our majestic ferry brand">
            <img src="/images/logos/ranoh-logo.webp" alt="Logo of our ranoh island brand">
            <img src="/images/logos/meyer-rental-logo.webp" alt="Logo of our meyer rental brand">
            <img src="/images/logos/nusa-indah-logo.webp" alt="Logo of our nusa indah brand">
            <img src="/images/logos/bcift-logo.webp" alt="Logo of our bcift brand">
            <img src="/images/logos/veranta-cafe-logo.webp" alt="Logo of our veranta cafe brand">
            <img src="/images/logos/majestic-koi-farm-logo.webp" alt="Logo of our majestic koi farm brand">

          </div>
        </div>
      </section>
    </main>

    <%- include('../partials/footer') %>

    <%- include('../partials/loginModal') %>

    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
    <script src="/js/home.js"></script>
  </body>
</html>