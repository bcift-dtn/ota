<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Travel Agent</title>

    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/components.css">
    
  </head>

  <body>
    <!-- Login button will be on navbar right side -->
    <%- include('../partials/navbar') %>

    <h1>Hello, World!</h1>

    <%- include('../partials/footer') %>

    <!-- Login Modal -->
    <div class="modal-overlay hidden" id="modalOverlay">
      <div class="login-modal" id="loginModal">
        <span id="closeModal">x</span>
        <h3>SIGN IN</h3>

        <form id="loginModalForm">
          <div class="email">
            <label for="emailField">Email:</label>
            <input type="email" class="email-field" id="emailField" name="email" placeholder="Enter Email" required>
          </div>

          <div class="password">
            <label for="passwordField">Password:</label>
            <input type="password" class="password-field" id="passwordField" name="password" placeholder="Enter Password" required>
          </div>

          <button type="submit" class="submit-login-btn" id="submitLoginBtn">
            SIGN IN
          </button>
        </form>

        <div class="modal-optional-option">
          <a href="#">Forgot Password?</a>
          <p>Don't have an account? <a href="/auth/register">Sign Up</a></p>
        </div>
      </div>
    </div>

    <script src="/js/modal.js"></script>
  </body>
</html>