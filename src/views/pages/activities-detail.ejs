<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.title %> - OTA</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/pages/product-detail.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  </head>

  <body>
    <%- include('../partials/navbar') %>
    
    <main>
      <section class="list-hero-banner hero-activities-list">
        <img src="/images/hero-banners/ranoh-hero.webp" alt="Activities Hero Banner">
        <h1>ACTIVITIES</h1>
      </section>
      <%- include('../partials/breadcrumb', { breadcrumbs }) %>

      <section class="detail-container">
        <div class="detail-top">
          <div class="detail-gallery">
            <% 
              const packageImages = product.images.filter(img => 
                img.package_id === selectedPackage.id || img.package_id === null
              );

              const mainImage = packageImages.length > 0 ? packageImages[0].url : '/images/placeholder.webp';
            %> 
            <img class="detail-main-image" src="<%= mainImage %>" alt="Image of <%= product.brand %> <%= product.model %> car">
            <div class="detail-thumbnails">
              <% packageImages.forEach((img, index) => { %>
               <img class="detail-thumbnail <%= index === 0 ? 'active-thumb' : '' %>"
                src="<%= img.url %>"
                alt="<%= product.title %> image <%= index + 1 %>">
              <% }) %>
            </div>
          </div>

          <div class="detail-summary">
            <div class="detail-summary-top">
              <h1 class="product-heading"><%= product.title %></h1>
              <p class="even-bigger-label">IDR <%= selectedPackage.formatted_price %></p>
            </div>

            <div class="detail-badges">
              <div class="package-amenities">
                  <% product.amenities.forEach(amenity => { %>
                    <p class="abit-smaller-label">
                      <i data-lucide="<%= amenity.icon_lucide %>"></i><%= amenity.name %>
                    </p>
                  <% }) %>

                  <% selectedPackage.amenities.forEach(amenity => { %>
                    <p class="abit-smaller-label">
                      <i data-lucide="<%= amenity.icon_lucide %>"></i><%= amenity.name %>
                    </p>
                  <% }) %>
              </div>
            </div>
          </div>
        </div>

        <div class="detail-important-info">
          <h2 class="product-heading"><i data-lucide="circle-alert"></i>Important Info</h2>
          <div class="section-list-content abit-smaller-label">
              <ul>
                <% selectedPackage.important_info.split('\n').forEach(line => { %> 
                  <% if (line.trim().length > 0) { %>
                    <li><%= line.replace(/^[-•*]\s*/, '').trim() %></li>
                  <% } %>
                <% }) %> 
              </ul>
            </div>
        </div>

        <% if (selectedPackage.itinerary) { %>
          <div class="detail-itinerary detail-important-info">
            <h2 class="product-heading"><i data-lucide="clock"></i>Itinerary</h2>
            <div class="section-list-content abit-smaller-label">
              <ul>
                <% selectedPackage.itinerary.split('\n').forEach(line => { %> 
                  <% if (line.trim().length > 0) { %>
                    <li><%= line.replace(/^[-•*]\s*/, '').trim() %></li>
                  <% } %>
                <% }) %> 
              </ul>
            </div>
          </div>
        <% } %>

        <div class="detail-location-info">
          <h2 class="product-heading"><i data-lucide="map-pinned"></i>Location Information</h2>
          <div class="map-container">
            <% if (product.map_embed_url) { %>
              <iframe src="<%= product.map_embed_url %> " width="100%" height="300" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            <% } else if (product.latitude && product.longitude) { %>
              <iframe width="100%" height="300" loading="lazy" allowfullscreen src="https://www.google.com/maps/embed/v1/place?key=test&q=<%= product.latitude %>,<%= product.longitude %>"></iframe>
            <% } else { %>
              <div class="no-map-available">
                <p>Map not available</p>
              </div>
            <% } %>
          </div>
        </div>

        <div class="detail-booking">
          <h2 class="product-heading"><i data-lucide="receipt-text"></i>Booking Information</h2>
          <form action="#">
            <div class="booking-input-wrapper">
              <div class="booking-pickup-date-wrapper">
                <label for="activitiesCheckInDate" class="label-text">Check In Date</label>
              <input type="date" class="activities-check-in-date date-input" id="activitiesCheckInDate" name="activitiesCheckInDate"
                value="" placeholder="Select date..." required>
              </div>

              <div class="booking-pickup-time-wrapper">
                <label class="label-text" for="slotTime">Slot Time</label>
                <select name="slotTime" id="slotTime" class="slot-time-selector">
                  <% if (selectedPackage.timeSlots && selectedPackage.timeSlots.length > 0) { %>
                    <% selectedPackage.timeSlots.forEach(slot => { %>
                      <option value="<%= slot.time_string %>"><%= slot.time_string %></option>
                    <% }) %>
                  <% } else { %>
                    <option value="Anytime" disabled>No slots available</option>
                  <% } %>
                </select>
              </div>

              <% if (selectedPackage.pricing_type === 'per_unit') { %>
                <div class="quantity-counter">
                  <p class="label-text">Quantity</p>
                  <select name="bookingQuantity" id="bookingQuantity">
                    <% for (let i = 1; i <= selectedPackage.max_quantity; i++) { %>
                      <option value="<%= i %>"><%= i %></option>
                    <% } %>
                  </select>
                </div>
              <% } %>
            </div>

            <div class="pax-counter-wrapper">
              <% if (selectedPackage.pricing_type === 'per_pax') { %>
                <% selectedPackage.pricingTiers.forEach(pricingTier => { %>
                  <% const minPax = pricingTier.tier_title.toLowerCase() === 'adult' ? 1 : 0 %>
                  <div class="pax-counter" data-price="<%= pricingTier.normal_price %>" data-min="<%= minPax %>">
                    <div class="pax-counter-left">
                      <p class="label-text"><%= pricingTier.tier_title.toUpperCase() %></p> 

                      <% if (pricingTier.normal_price === 0 ) { %> 
                        <p class="bigger-label">FREE</p> 
                      <% } else { %> 
                        <p class="bigger-label">IDR <%= pricingTier.normal_price.toLocaleString('id-ID') %></p> 
                      <% } %>
                      
                      <p class="even-smaller-label"><%= pricingTier.tier_description %></p>
                    </div>
            
                    <div class="pax-counter-right">
                      <button class="pax-counter-minus">-</button>
                      <p class="pax-counter-text"><%= minPax %></p>
                      <button class="pax-counter-plus">+</button>
                    </div>
                  </div>
                <% }) %>
                <% } else { %>
                    <% if (selectedPackage.pricingTiers && selectedPackage.pricingTiers.length > 0) { %>
                      <div class="informational-pax-wrapper">
                        <% selectedPackage.pricingTiers.forEach(pricingTier => { %>
                          <% const minPax = pricingTier.tier_title.toLowerCase() === 'adult' ? 1 : 0; %>
                          <div class="pax-counter informational-pax" data-price="0" data-min="<%= minPax %>">
                            <div class="pax-counter-left">
                              <p class="label-text"><%= pricingTier.tier_title.toUpperCase() %></p>
                              <p class="even-smaller-label"><%= pricingTier.tier_description %></p>
                            </div>
                            <div class="pax-counter-right">
                              <button class="pax-counter-minus">-</button>
                              <p class="pax-counter-text"><%= minPax %></p>
                              <button class="pax-counter-plus">+</button>
                            </div>
                          </div>
                        <% }) %> 
                      </div>
                    <% } %>
                <% } %>
            </div>

            <% const coreAddons = selectedPackage.addons ? selectedPackage.addons.filter(a => a.display_category === 'core') : []; %>
            <% const generalAddons = selectedPackage.addons ? selectedPackage.addons.filter(a => a.display_category === 'general') : []; %>

            <% if (coreAddons.length > 0) { %>
             <div class="core-addons-wrapper">
              <% coreAddons.forEach(addon => { %> 
                <div class="pax-counter core-addon" data-price="<%= addon.price %>" data-max="<%= addon.max_quantity || 10 %>" data-min="0">
                  <div class="pax-counter-left">
                    <p class="label-text"><%= addon.name.toUpperCase() %></p>
                    <p class="bigger-label">IDR <%= Number(addon.price).toLocaleString('id-ID') %></p>
                  </div>
                  <div class="pax-counter-right">
                    <button type="button" class="pax-counter-minus addon-minus">-</button>
                    <p class="pax-counter-text addon-qty-val">0</p>
                    <button type="button" class="pax-counter-plus addon-plus">+</button>
                  </div>
                </div>
              <% }) %>
             </div>
            <% } %>

            <% if (generalAddons.length > 0) { %>
              <div class="booking-addons-collapsible">
                <button type="button" class="addons-toggle-btn" id="addonsToggleBtn">
                  <span class="label-text">Available Add-ons</span>
                  <i data-lucide="chevron-down" class="addons-chevron"></i>
                </button>

                <div class="addons-content hidden" id="addonsContent">
                  <% selectedPackage.addons.forEach(addon => { %>
                    <div class="addon-item">
                      <label class="addon-label">
                        <input type="checkbox" class="addon-checkbox" 
                          data-price="<%= addon.price %>" 
                          data-min="<%= addon.min_pax || 1 %>"
                          data-max="<%= addon.max_pax || addon.max_quantity || 10 %>"
                          data-pricing-type="<%= addon.pricing_type %>"
                          value="<%= addon.id %>">
                        
                        <div class="addon-info">
                          <span class="addon-name label-text"><%= addon.name %></span>
                          <span class="addon-price bigger-label label-text">+IDR <%= Number(addon.price).toLocaleString('id-ID') %> </span>
                          <% if (addon.description) { %>
                            <p class="even-smaller-label addon-desc label-text"><%= addon.description %></p>
                          <% } %>
                        </div>
                      </label>

                      <div class="addon-controls hidden">
                        <% if (addon.pricing_type === 'per_pax') { %>
                         <div class="pax-counter-right addon-pax-counter">
                          <button type="button" class="pax-counter-minus addon-minus">-</button>
                          <p class="pax-counter-text addon-qty-val"><%= addon.min_pax || 1 %></p>
                          <button type="button" class="pax-counter-plus addon-plus">+</button>
                         </div>
                        <% } else { %>
                          <div class="quantity-counter addon-unit-selector">
                            <select name="" id="" class="addon-qty-val">
                              <% const maxQty = addon.max_quantity || 5; %>
                              <% for (let i = 1; i <= maxQty; i++) { %>
                                <option value="<%= i %>"><%= i %></option>
                              <% } %>
                            </select>
                          </div>
                        <% } %>
                      </div>
                    </div>
                  <% }) %>
                </div>

              </div>
            <% } %>

            <div class="booking-summary">
              <% if (selectedPackage.pricing_type === "per_pax") { %>
                <div class="booking-summary-quantity">
                  <p>Total Pax</p>
                  <p id="bookingPaxQuantityText">1 People</p>
                </div>
              <% } else { %>
                <div class="booking-summary-daily-rate">
                  <p>Daily Rate</p>
                  <p id="packagePrice" data-price="<%= selectedPackage.normal_price %>">IDR <%= selectedPackage.formatted_price %></p>
                </div>

                <% if (selectedPackage.pricingTiers && selectedPackage.pricingTiers.length > 0) { %>
                  <div class="booking-summary-quantity">
                    <p>Total Pax</p>
                    <p id="bookingPaxQuantityText">0 People</p> 
                  </div>
                <% } %>

                <div class="booking-summary-quantity">
                  <p>Quantity</p>
                  <p id="bookingQuantityText">1 Unit</p>
                </div>
              <% } %>
            </div>

            <div class="booking-total-price">
              <p class="bigger-label">Total Price</p>
              <p class="bigger-label" id="bookingTotalPriceText">IDR <%= selectedPackage.formatted_price %></p> <!-- total price calculation -->
            </div>

            <button class="booking-continue-btn" id="bookingContinueBtn">CONTINUE</button>
          </form>
        </div>
      </section>
    </main>

    <%- include('../partials/footer') %>

    <%- include('../partials/loginModal') %>

    <input type="hidden" id="currentProductType" value="<%= product.type %>">
    <input type="hidden" id="currentProductId" value="<%= product.id %>">
    <input type="hidden" id="currentPackageId" value="<%= selectedPackage.id %>">

    <script>
      const packageDurationHours = <%= selectedPackage.duration_hours || 'null' %>;
      const currentUser = <%- JSON.stringify(user).replace(/</g, '\\u003c')  %>;
    </script>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="/js/activities-detail.js"></script>
  </body>
</html>