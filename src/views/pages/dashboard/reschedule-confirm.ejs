<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reschedule Booking - Dashboard - MEGATERRA</title>
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/pages/dashboard.css" />
  </head>
  <body>
    <%- include('../../partials/navbar') %>

    <main>
      <div class="dashboard-banner">
        <img
          src="/images/hero-banners/contact-hero.webp"
          alt="Dashboard Banner"
        />
      </div>

      <section class="dashboard-container">
        <aside class="dashboard-sidebar">
          <ul class="dashboard-sidebar-nav">
            <li>
              <a href="/dashboard/personal-info"
                ><i data-lucide="user"></i> Personal Info</a
              >
            </li>
            <li>
              <a href="/dashboard/account-security"
                ><i data-lucide="lock"></i> Account and security</a
              >
            </li>
            <li>
              <a href="/dashboard/points"
                ><i data-lucide="tickets"></i> My points</a
              >
            </li>
            <li>
              <a href="/dashboard/orders" class="active"
                ><i data-lucide="receipt-text"></i> My Orders</a
              >
            </li>
            <li>
              <a href="/dashboard/status"><i data-lucide="bell"></i> Status</a>
            </li>
          </ul>
        </aside>

        <section class="dashboard-content">
          <div class="cancel-confirm-wrapper">
            <div class="cancel-confirm-header">
              <a href="/dashboard/orders" class="cancel-back-link">
                <i data-lucide="arrow-left"></i> Back to My Orders
              </a>
              <h2 class="cancel-confirm-title">Reschedule Booking</h2>
              <p class="cancel-confirm-subtitle">
                Select your new preferred date. Our team will review and confirm your request.
              </p>
            </div>

            <!-- Current Booking Summary -->
            <div class="cancel-order-summary">
              <div class="cancel-order-meta">
                <span class="cancel-order-id">Order #MT-<%= (order.product_type || 'ORDER').toUpperCase() %>-<%= order.id %></span>
                <span class="cancel-order-product"><%= order.product_title %></span>
                <% if (order.start_date) { %>
                  <span class="cancel-order-date">
                    <i data-lucide="calendar"></i>
                    Current Date: <%= new Date(order.start_date).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
                  </span>
                <% } %>
              </div>
            </div>

            <!-- Reschedule Policy Card -->
            <div class="cancel-refund-breakdown">
              <h3 class="cancel-refund-title">Reschedule Information</h3>
              <div class="cancel-refund-row">
                <span>Reschedule Fee</span>
                <span style="color: #276749; font-weight: 600;">FREE</span>
              </div>
              <p class="cancel-refund-note">
                <i data-lucide="info"></i>
                Reschedule requests are subject to operator availability. Your original booking remains active until the new date is approved.
              </p>
            </div>

            <!-- Reschedule Form -->
            <% 
              // Set minimum selectable date to tomorrow
              const tomorrow = new Date();
              tomorrow.setDate(tomorrow.getDate() + 1);
              const minDateStr = tomorrow.toISOString().split('T')[0];
            %>
            <form action="/dashboard/orders/<%= order.id %>/reschedule" method="POST" class="cancel-form">
              <div class="cancel-reason-group">
                <label for="newDate">New Preferred Date <span style="color: #c53030;">*</span></label>
                <input 
                  type="date" 
                  id="newDate" 
                  name="newDate" 
                  min="<%= minDateStr %>" 
                  required 
                  class="reschedule-date-input"
                />
              </div>

              <div class="cancel-reason-group">
                <label for="reason">Reason for Rescheduling <span>(optional)</span></label>
                <textarea id="reason" name="reason" rows="3" placeholder="Tell us why you'd like to change dates..."></textarea>
              </div>

              <div class="cancel-form-actions">
                <a href="/dashboard/orders" class="btn-order-action btn-secondary">Keep Original Date</a>
                <button type="submit" class="btn-order-action btn-primary">Submit Reschedule Request</button>
              </div>
            </form>
          </div>
        </section>
      </section>
    </main>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/loginModal') %>
  </body>
</html>
