<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Orders - Dashboard - MEGATERRA</title>

    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/pages/dashboard.css" />
  </head>

  <body>
    <%- include('../../partials/navbar') %>

    <main>
      <div class="dashboard-banner">
        <img
          src="/images/hero-banners/contact-hero.webp"
          alt="Dashboard Banner"
        />
      </div>

      <section class="dashboard-container">
        <!-- Sidebar Nav -->
        <aside class="dashboard-sidebar">
          <ul class="dashboard-sidebar-nav">
            <li>
              <a href="/dashboard/personal-info">
                <i data-lucide="user"></i> Personal Info
              </a>
            </li>

            <li>
              <a href="/dashboard/account-security">
                <i data-lucide="lock"></i> Account and security
              </a>
            </li>

            <li>
              <a href="/dashboard/points">
                <i data-lucide="tickets"></i> My points
              </a>
            </li>

            <li>
              <a href="/dashboard/orders" class="active">
                <i data-lucide="receipt-text"></i> My Orders
              </a>
            </li>

            <li>
              <a href="/dashboard/status">
                <i data-lucide="bell"></i> Status
              </a>
            </li>
          </ul>
        </aside>

        <!-- My Orders Main Content -->
        <section class="dashboard-content orders-content-wrapper">
          <div class="orders-header-row">
            <div class="orders-header-text">
              <h2 class="orders-main-title">My Bookings & Trips</h2>
              <p class="orders-subtitle">
                Manage upcoming transfers, access e-vouchers, and review your payment transactions.
              </p>
            </div>

            <form action="/dashboard/orders" method="GET" class="orders-search-box">
              <input type="hidden" name="status" value="<%= currentStatus %>">
              <input type="hidden" name="type" value="<%= currentType %>">
                <i data-lucide="search" class="search-icon"></i>
              <input type="text" name="search" class="search-input" placeholder="Search by trip or order ID" value="<%= searchQuery || '' %>">
            </form>
          </div>

          <!-- Status Filter -->
          <div class="orders-status-tabs">
            <a
              href="/dashboard/orders?status=all&type=<%= currentType %>&search=<%= searchQuery %>"
              class="tab-link <%= currentStatus === 'all' ? 'active' : '' %>"
            >
              ALL <span class="tab-badge"><%= counts.all %></span>
            </a>

            <a
              href="/dashboard/orders?status=upcoming&type=<%= currentType %>&search=<%= searchQuery %>"
              class="tab-link <%= currentStatus === 'upcoming' ? 'active' : '' %>"
            >
              Upcoming <span class="tab-badge"><%= counts.upcoming %></span>
            </a>

            <a
              href="/dashboard/orders?status=completed&type=<%= currentType %>&search=<%= searchQuery %>"
              class="tab-link <%= currentStatus === 'completed' ? 'active' : '' %>"
            >
              Completed <span class="tab-badge"><%= counts.completed %></span>
            </a>

            <a
              href="/dashboard/orders?status=cancelled&type=<%= currentType %>&search=<%= searchQuery %>"
              class="tab-link <%= currentStatus === 'cancelled' ? 'active' : '' %>"
            >
              Cancelled <span class="tab-badge"><%= counts.cancelled %></span>
            </a>
          </div>

          <!-- product filter -->
          <div class="orders-category-pills">
            <a
              href="/dashboard/orders?status=<%= currentStatus %>&type=all&search=<%= searchQuery %>"
              class="pill-link <%= currentType === 'all' ? 'active' : '' %>"
            >
              All Products
            </a>
            <a
              href="/dashboard/orders?status=<%= currentStatus %>&type=ferry&search=<%= searchQuery %>"
              class="pill-link <%= currentType === 'ferry' ? 'active' : '' %>"
            >
              Ferry
            </a>
            <a
              href="/dashboard/orders?status=<%= currentStatus %>&type=car_rental&search=<%= searchQuery %>"
              class="pill-link <%= currentType === 'car_rental' ? 'active' : '' %>"
            >
              Car Rental
            </a>
            <a
              href="/dashboard/orders?status=<%= currentStatus %>&type=activities&search=<%= searchQuery %>"
              class="pill-link <%= currentType === 'activities' ? 'active' : '' %>"
            >
              Activities
            </a>
          </div>

          <!-- Orders card list -->
          <div class="orders-list">
            <% if (orders && orders.length > 0) { %> 
              <% orders.forEach(order =>  { %> 
                <% 
                  const isPaid = order.payment_status === 'paid';
                  const isCancelled = order.status === 'cancelled' || order.payment_status === 'failed';
                  const orderDate = order.start_date ? new Date(order.start_date) : new Date(order.created_at);
                  const isPast = order.start_date ? (new Date(order.start_date) < new Date().setHours(0,0,0,0)) : false;

                  // Status Badge
                  let badgeText = 'Confirmed & Paid';
                  let badgeClass = 'badge-confirmed';

                  if (isCancelled) {
                    badgeText = 'Cancelled';
                    badgeClass = 'badge-cancelled';
                  } else if (order.status === 'completed' || (isPaid && isPast)) {
                    badgeText = 'Completed';
                    badgeClass = 'badge-completed';
                  } else if (!isPaid) {
                    badgeText = 'Awaiting Payment';
                    badgeClass = 'badge-awaiting';
                  }

                  const productTypeUpper = (order.product_type || 'ORDER').toUpperCase();
                  const rawOrderId = `MT-${productTypeUpper}-${order.id}`;

                  // Product Subtitle
                  let productSubtitle = '';
                  let journeyType = '1';
                  let departTime = '';
                  if (order.product_type === 'ferry' && order.passengers?.ferrySnapshot) {
                    journeyType = order.passengers.ferrySnapshot.journeyType || '1';
                    productSubtitle = journeyType === '2' ? 'Round Trip Ferry Transfer' : 'One Way Ferry Transfer';
                    const tripCode = order.passengers.ferrySnapshot.departTripCode || '';
                    if (tripCode.length >= 4) {
                      departTime = `${tripCode.slice(-4, -2)}:${tripCode.slice(-2)} WIB`;
                    }
                  } else if (order.product_type === 'car_rental') {
                    productSubtitle = 'Car Rental Charter';
                  } else if (order.product_type === 'activities') {
                    productSubtitle = 'Tour & Activity Package';
                  }
                %>

                <article class="order-card">
                  <div class="order-card-header">
                    <div class="order-header-left">
                      <span class="order-status-dot-badge <%= badgeClass %>">
                        <span class="status-dot"></span> <%= badgeText %>
                      </span>
                      <span class="order-reference-code">#<%= rawOrderId %></span>
                      <span class="order-created-date">
                        • Booked on <%= new Date(order.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                      </span>
                    </div>
                  </div>

                  <div class="order-card-body">
                    <div class="order-thumbnail-box">
                      <% if (order.product_image) { %>
                        <img src="<%= order.product_image %>" alt="<%= order.product_title %>" class="order-thumb-img" />
                      <% } else if (order.product_type === 'ferry') { %>
                        <i data-lucide="ship" class="order-thumb-icon"></i>
                      <% } else if (order.product_type === 'car_rental') { %>
                        <i data-lucide="car" class="order-thumb-icon"></i>
                      <% } else { %>
                        <i data-lucide="compass" class="order-thumb-icon"></i>
                      <% } %>
                    </div>
                    
                    <div class="order-body-info">
                      <h3 class="order-product-title"><%= order.product_title %></h3>

                      <% if (productSubtitle) { %>
                        <p class="order-product-subtitle"><%= productSubtitle %></p>
                      <% } %>

                      <div class="order-meta-row">
                        <span class="meta-item">
                          <i data-lucide="calendar" class="meta-icon"></i>
                          <%= orderDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                          <%= departTime ? `• ${departTime}` : '' %>
                        </span>
                        <span class="meta-item">
                          <i data-lucide="users" class="meta-icon"></i>
                          <%= order.quantity || 1 %> <%= order.product_type === 'car_rental' ? 'Vehicle(s)' : 'Guest(s)' %>
                        </span>
                      </div>

                      <div class="order-features-row">
                        <% if (order.product_type === 'car_rental') { %>
                          <span class="product-feature-tag">
                            <i data-lucide="navigation" class="feature-icon"></i> Driver Included
                          </span>
                        <% } else if (order.product_type === 'ferry' && journeyType === '2') { %>
                          <span class="product-feature-tag">
                            <i data-lucide="repeat" class="feature-icon"></i> Round Trip
                          </span>
                        <% } %>
                      </div>
                    </div>

                    <div class="order-price-box">
                      <span class="order-price-label"><%= isPaid ? 'Total Paid' : 'Total Amount' %></span>
                      <strong class="order-price-val">IDR <%= Number(order.total_amount || 0).toLocaleString('id-ID') %></strong>
                    </div>
                  </div>

                  <div class="order-card-footer">
                    <div class="order-payment-info">
                      <i data-lucide="credit-card" class="payment-icon"></i>
                      <span>
                        <%= order.payment_method === 'online' ? 'Online Payment' : (order.payment_method || 'Online Payment') %>
                        (<%= isPaid ? 'Paid' : 'Unpaid' %>)
                      </span>
                    </div>

                    <div class="order-footer-actions">
                      <a href="/products/checkout/result?orderId=<%= rawOrderId %>&action=reschedule" class="btn-order-action btn-secondary">
                        <i data-lucide="calendar"></i> Reschedule
                      </a>

                      <a href="/products/checkout/result?orderId=<%= rawOrderId %>" class="btn-order-action btn-secondary">
                        <i data-lucide="receipt"></i> View Receipt
                      </a>

                      <a href="/products/checkout/result?orderId=<%= rawOrderId %>" class="btn-order-action btn-primary">
                        <i data-lucide="download"></i> Download E-Voucher
                      </a>

                      <% if (!isCancelled && !isPast) { %>
                        <a href="/products/checkout/result?orderId=<%= rawOrderId %>&action=cancel" class="btn-order-action btn-cancel">
                          <i data-lucide="x-circle"></i> Cancel
                        </a>
                      <% } %>
                    </div>
                  </div>
                </article>
              <% }) %>
            <% } else { %> 
              <!-- If no order found -->
              <div class="orders-empty-state">
                <i data-lucide="inbox" class="empty-icon"></i>
                <h3>No orders found</h3>
                <p>You have no <%= currentStatus === 'all' ? '' : currentStatus %> bookings matching your search.</p>
                <a href="/" class="btn-empty-explore">Explore Products</a>
              </div>
            <% } %>
          </div>

          <!-- Pagination -->
          <% if (totalPages > 1) { %> 
            <nav class="orders-pagination">
              <% if (currentPage > 1) { %> 
                <a href="/dashboard/orders?status=<%= currentStatus %>&type=<%= currentType %>&search=<%= searchQuery %>&page=<%= currentPage - 1 %>" class="page-link page-prev">
                  <i data-lucide="chevron-left"></i> Previous
                </a>
              <% } %>

              <div class="page-numbers">
                <% for (let i = 1; i <= totalPages; i++) { %>
                  <a
                    href="/dashboard/orders?status=<%= currentStatus %>&type=<%= currentType %>&search=<%= searchQuery %>&page=<%= i %>"
                    class="page-num <%= currentPage === i ? 'active' : '' %>"
                  >
                    <%= i %>
                  </a>
                <% } %>
              </div>

              <% if (currentPage < totalPages) { %> 
                <a
                  href="/dashboard/orders?status=<%= currentStatus %>&type=<%= currentType %>&search=<%= searchQuery %>&page=<%= currentPage + 1 %>"
                  class="page-link page-next"
                >
                  Next <i data-lucide="chevron-right"></i>
                </a>
              <% } %>
            </nav>  
          <% } %>
        </section>
      </section>
    </main>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/loginModal') %>
  </body>
</html>
