<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Personal Info - Dashboard - MEGATERRA</title>

    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/pages/dashboard.css" />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/css/intlTelInput.css"
    />
  </head>
  <body>
    <%- include('../../partials/navbar') %>

    <main>
      <!-- Hero banner -->
      <div class="dashboard-banner">
        <img
          src="/images/hero-banners/contact-hero.webp"
          alt="Contact Us Banner"
        />
      </div>

      <section class="dashboard-container">
        <aside class="dashboard-sidebar">
          <ul class="dashboard-sidebar-nav">
            <li>
              <a href="/dashboard/personal-info" class="active"
                ><i data-lucide="user"></i> Personal info</a
              >
            </li>
            <li>
              <a href="/dashboard/account-security"
                ><i data-lucide="lock"></i> Account and security</a
              >
            </li>
            <li>
              <a href="#"><i data-lucide="tickets"></i> My points</a>
            </li>
            <li>
              <a href="#"><i data-lucide="receipt-text"></i> My orders</a>
            </li>
            <li>
              <a href="#"><i data-lucide="bell"></i> Status</a>
            </li>
          </ul>
        </aside>
        <section class="dashboard-content">
          <h1 class="dashboard-title">Personal Info</h1>
          <h3>Account info</h3>
          <form
            action="/dashboard/update-profile"
            method="POST"
            class="dashboard-form"
          >
            <div class="dashboard-form-group">
              <label for="fullName">Full Name</label>
              <input
                type="text"
                id="fullName"
                name="fullName"
                placeholder="Enter full name"
                value="<%= user.fullName || ''%>"
                required
              />
            </div>
            <div class="form-row">
              <div class="dashboard-form-group">
                <label for="phone">Phone</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="Enter phone number"
                  value="<%= user.phone || '' %>"
                  required
                />
              </div>
              <div class="dashboard-form-group">
                <label for="email">Email</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="Enter your email"
                  value="<%= user.email || '' %>"
                  required
                />
              </div>
            </div>
            <div class="dashboard-form-group">
              <label for="address">Your Address</label>
              <input
                type="text"
                id="address"
                name="address"
                placeholder="Enter your address"
                value="<%= user.address || '' %>"
                required
              />
            </div>

            <button type="submit" class="dashboard-submit-btn">
              Update profile
            </button>
          </form>
        </section>
      </section>
    </main>

    <%- include('../../partials/footer') %> <%-
    include('../../partials/loginModal') %>

    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/intlTelInput.min.js"></script>
    <script src="/js/dashboard.js"></script>
  </body>
</html>
