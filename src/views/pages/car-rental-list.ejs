<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Car Rental - OTA</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/components/search.css">
    <link rel="stylesheet" href="/css/pages/car-rental-list.css">
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <main>
      <section class="list-hero">
        <h1>CAR RENTAL</h1>
      </section>

      <section class="search-component">
        <div class="search-form" data-form="car-rental">
          <form action="/products/car-rental" method="GET">
            <div class="search-component-left">
              <div class="search-form-top">
                <div class="driver-wrapper">
                  <input type="radio" class="with-driver-radio" id="withDriverRadio" name="driver-needs" value="with-driver"
                    <%= searchParams.driverNeeds === 'with-driver' ? 'checked' : '' %>>
                  <label for="withDriverRadio">With Driver</label>
                  <input type="radio" class="without-driver-radio" id="withoutDriverRadio" name="driver-needs" value="without-driver"
                    <%= searchParams.driverNeeds === 'without-driver' ? 'checked' : '' %>>
                  <label for="withoutDriverRadio">Without Driver</label>
                </div>
              </div>
              <div class="search-form-bottom">
                <div class="search-input-wrapper">
                  <label for="carRentalLocation">Location</label>
                  <div class="input-icon-wrapper">
                    <img src="/images/icons/location-pin.svg" alt="Map pin" width="24">
                    <input type="text" class="car-rental-location" id="carRentalLocation" name="carRentalLocation"
                      value="<%= searchParams.location %>" placeholder="Batam" required>
                    <img src="/images/icons/chevron-down.svg" alt="Chevron arrow pointing down" width="19.2">
                  </div>
                </div>
                <div class="search-date-wrapper">
                  <div class="search-input-wrapper">
                    <label for="carPickupDate">Car Pickup Date</label>
                    <input type="date" class="car-pickup-date" id="carPickupDate" name="carPickupDate"
                      value="<%= searchParams.pickupDate %>" required>
                  </div>
                  <div class="search-input-wrapper">
                    <label for="carReturnDate">Car Return Date</label>
                    <input type="date" class="car-return-date" id="carReturnDate" name="carReturnDate"
                      value="<%= searchParams.returnDate %>" required>
                  </div>
                </div>
              </div>
            </div>

            <button type="submit" class="submit-search-btn" id="submitCarRentalSearchBtn">Search</button>
          </form>
        </div>
      </section>

      <%- include('../partials/breadcrumb', { breadcrumbs }) %>

      <section class="product-list">
        <div class="product-list-container">
          <% products.forEach(product => { %> 
            <div class="product-card-horizontal" data-product-id="<%= product.id %>">
              <div class="product-card-top">
                <div class="product-card-image">
                  <% if (product.image_url) { %>
                    <img src="<%= product.image_url %>" alt="<%= product.title %>">
                  <% } else { %>
                    <div class="product-card-image-placeholder"></div>
                  <% } %>
                </div>
                <div class="product-card-info">
                  <div class="product-card-info-split">
                    <div class="product-card-info-left">
                      <h2><%= product.title %></h2>
                      <div>
                        <p><!-- Icon here --> <%= product.transmission.toUpperCase() %></p>
                        <p><!-- Icon here --> <%= product.seats %></p>
                      </div>
                      <% if (product.with_driver) { %>
                        <p><!-- Icon here --> Driver Included</p>
                      <% } else { %>
                        <p><!-- Icon here --> Without Driver</p>
                      <% } %>
                    </div>
                    <div class="product-card-info-right">
                      <div>
                        <p>Start from</p>
                        <div class="product-card-price-wrapper">
                          <p class="product-card-price">IDR <%= product.formatted_starting_price %></p>
                        </div>
                      </div>
                      <button class="detail-btn">Detail</button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="package-dropdown hidden">
                <div class="package-dropdown-header">
                  <p class="smaller-label">SELECT TRANSFER PACKAGE</p>
                  <p class="package-error smaller-label warning-text hidden">Please select a package first.</p>
                </div>
                <div class="package-list">
                  <% product.packages.forEach ((package, index) => { %>
                    <div class="package-option <%= index === 0 ? 'active' : '' %>" data-package-id="<%= package.id %>" data-price="<%= package.normal_price%>">
                      <div class="package-option-info">
                        <p class="package-name bigger-label <%= index === 0 ? 'active-text' : '' %>"><%= package.name %></p>
                        <p class="package-description smaller-label"><%= package.description %></p>
                      </div>
                      <p class="package-price bigger-label <%= index === 0 ? 'active-text' : '' %>">IDR <%= package.formatted_price %></p>
                    </div>
                  <% }) %>
                  <button class="confirm-selection-btn">CONFIRM SELECTION</button>
                </div>
              </div>
            </div>
          <% }) %>

          <% if (products.length === 0) { %>
            <p>No cars available at the moment.</p>
          <% } %>
        </div>
      </section>
    </main>
    
    <%- include('../partials/footer') %>

    <%- include('../partials/loginModal') %>

    <script src="/js/car-rental-list.js"></script>
  </body>
</html>
