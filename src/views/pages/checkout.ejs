<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= product.title %> - Checkout - OTA
  </title>
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/layout.css" />
  <link rel="stylesheet" href="/css/components.css" />
  <link rel="stylesheet" href="/css/pages/checkout.css" />
</head>

<body>
  <%- include('../partials/navbar') %>

    <main class="checkout-main">
      <section class="checkout-container">
        <div class="checkout-progress-wrapper">
          <div class="progress-step active">
            <div class="progress-circle">1</div>
            <span>Details</span>
          </div>

          <div class="progress-line"></div>

          <div class="progress-step">
            <div class="progress-circle">2</div>
            <span>Payment</span>
          </div>

          <div class="progress-line"></div>

          <div class="progress-step">
            <div class="progress-circle">3</div>
            <span>Confirmation</span>
          </div>
        </div>
        <a href="javascript:history.back()" class="back-link">
          <i data-lucide="arrow-left"></i> Back to Details
        </a>
        <form action="/checkout/pay" method="POST" class="checkout-layout">
          <div class="checkout-forms">
            <section class="booking-details-section">
              <h2 class="checkout-heading"><i data-lucide="users"></i> Booking Contact</h2>
        
              <div class="input-group">
                <select name="bookingRole" id="bookingRole">
                  <option value="self">I am the visitor</option>
                  <option value="other">I am booking for someone else</option>
                </select>
              </div>
            </section>
        
            <section class="visitor-details-section">
        
              <% for (let i=1; i <=draftOrder.totalPax; i++) { %>
                <div class="visitor-card">
                  <h2 class="checkout-heading"><i data-lucide="users"></i> Visitor Details</h2>
                  <h3>Visitor <%= i %>
                      <%= i===1 ? '(Lead Visitor)' : '' %>
                  </h3>
                  <div class="input-group">
                    <select name="visitorTitle_<%= i %>" id="visitorTitle_<%= i %>">
                      <option value="Mr">Mr.</option>
                      <option value="Mrs">Mrs.</option>
                      <option value="Ms">Ms.</option>
                    </select>
                  </div>
                  <div class="input-group">
                    <input type="text" name="visitorName_<%= i %>" id="visitorName_<%= i %>" placeholder="Full Name"
                      required>
                  </div>
                  <div class="input-group-split">
                    <div class="input-group">
                      <input type="number" name="visitorPhoneNumber_<%= i %>" id="visitorPhoneNumber_<%= i %>"
                        placeholder="Phone Number" required>
                    </div>
                    <div class="input-group">
                      <input type="email" name="visitorEmail_<%= i %>" id="visitorEmail_<%= i %>" placeholder="Email"
                        required>
                    </div>
                  </div>
                  <h3>Additional Information</h3>
                  <div class="input-group">
                    <textarea type="text" name="visitorRequest_<%= i %>" id="visitorRequest_<%= i %>"
                      placeholder="Special Requests (Optional)" rows="4"></textarea>
                  </div>
                </div>
                <% } %>
            </section>
          </div>
          <section class="checkout-sidebar">
            <div class="order-summary-card">
              <% if (product.image_url) { %>
                <img src="<%= product.image_url %>" alt="Product Image" class="summary-img">
              <% } %>
              <h2><%= product.title %></h2>
              <p class="summary-package-name"><%= selectedPackage.package_name || selectedPackage.name %></p>
              <div class="summary-details">
                <div class="summary-details-row">
                  <span><i data-lucide="calendar"></i> Date:</span>
                  <span><%= formattedVisitDate %></span>
                </div>
                <div class="summary-details-row">
                  <span><i data-lucide="clock"></i> Time:</span>
                  <span><%= draftOrder.slotTime %></span>
                </div>
                <% if (draftOrder.productType === 'car_rental') { %>
                  <div class="summary-details-row">
                    <span><i data-lucide="map-pin"></i>Pickup:</span>
                    <span><%= draftOrder.pickupLocation %></span>
                  </div>
                  <div class="summary-details-row">
                    <span><i data-lucide="users"></i> Quantity:</span>
                    <span><%= draftOrder.bookingQuantity %> Car(s)</span>
                  </div>
                <% } else { %>
                  <div class="summary-details-row">
                    <span><i data-lucide="users"></i> Total Visitors:</span>
                    <span><%= draftOrder.totalPax %> Person(s)</span>
                  </div>
                <% } %>
              </div>
              <div class="summary-price-breakdown">
                <div class="price-row smaller-label">
                  <span>Package Price</span>
                  <span>IDR <%= filteredBasePrice.toLocaleString('id-ID') %></span>
                </div>

                <div class="price-row smaller-label">
                  <span>Taxes (<%= (taxRate * 100) %>%)</span>
                  <span>IDR <%= taxAmount.toLocaleString('id-ID') %></span>
                </div>

                <div class="price-row smaller-label">
                  <span>Platform Fee</span>
                  <span>IDR <%= platformFee.toLocaleString('id-ID') %></span>
                </div>

                <div class="price-row total-row">
                  <span>Total Price</span>
                  <span class="total-price-text even-bigger-label">IDR <%= filteredGrandTotal.toLocaleString('id-ID') %></span>
                </div>
              </div>
              <div class="policy-box">
                <p class="smaller-label">
                  <i data-lucide="<%= selectedPackage.is_reschedulable ? 'calendar-check' : 'calendar-x' %>"></i>
                  <%= selectedPackage.is_reschedulable ? 'Can be rescheduled' : 'Cannot be rescheduled' %>
                </p>
                <p class="smaller-label">
                  <i data-lucide="<%= selectedPackage.is_refundable ? 'check-circle' : 'x-circle' %>"></i>
                  <%= selectedPackage.is_refundable ? 'Refundable' : 'Non-refundable' %>
                </p>
              </div>
              <button type="submit" class="submit-payment-btn">Continue to Payment</button>
            </div>
          </section>
        </form>
      </section>
    </main>



    <%- include('../partials/footer') %>

    <%- include('../partials/loginModal') %>

    <div id="pageData"
      data-user="<%- JSON.stringify(user || null).replace(/</g, '\\u003c').replace(/"/g, '&quot;') %>"
      hidden>
    </div>

    <script src="/js/checkout.js"></script>
</body>

</html>