<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OTA - Register</title>

    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/pages/register.css">
  </head>

  <body>
    <%- include('../partials/navbar') %>

    <div class="register-wrapper">
      <!-- Banner -->
      <section class="banner">

      </section>

      <!-- Register Form -->
      <section class="register-container">
        <div class="register-title">
          <h1>Create your account</h1>
          <p>It's free and easy</p>
        </div>

        <form id="registerForm" class="register-form">
          <p id="signupText" class="smaller-label warning-text"></p>
          <div class="register-fields">
            <label for="fullName">Full name:</label>
            <input type="text" name="fullName" id="fullName" placeholder="Enter your name" required>
          </div>

          <div class="register-fields">
            <label for="email">E-mail:</label>
            <input type="email" name="email" id="email" placeholder="Enter your e-mail" required>
            <label id="emailLabel" class="smaller-label warning-text" for="email"></label>
          </div>

          <div class="register-fields register-password-wrapper">
            <label for="password">Password:</label>
            <div>
              <input type="password" name="password" id="password" placeholder="Enter your password" minlength="8">
              <button type="button" class="toggle-password" data-target="password"><i data-lucide="eye-closed"></i></button>
            </div>
            <label for="password" id="passwordLabel" class="smaller-label"></label>
          </div>

          <div class="register-fields register-password-wrapper">
            <label for="confirmPassword">Confirm Password:</label>
            <div>
              <input type="password" name="confirmPassword" id="confirmPassword" placeholder="Confirm your password" minlength="8">
              <button type="button" class="toggle-password" data-target="confirmPassword"><i data-lucide="eye-closed">></i></button>
            </div>
            <label id="confirmPasswordLabel" for="confirmPassword" class="smaller-label warning-text"></label>
          </div>

          <div class="register-terms-checkbox">
            <input id="termsCheckbox" type="checkbox"> 
            <p>
              By creating an account means you agree to the
              <a href="#">Terms and Conditions</a>, and our
              <a href="#">Privacy Policy</a>.
            </p>
          </div>

          <button class="signup-btn" id="signupBtn">Sign Up</button>

          <!-- clicking Sign in open up login modal -->
          <p class="have-account-text">Already have an account? <span id="registerSigninBtn">Sign In</span></p>
        </form>
      </section>
    </div>

    <%- include('../partials/footer') %>

    <%- include('../partials/loginModal') %>

    <script src="/js/register.js"></script>
  </body>
</html>