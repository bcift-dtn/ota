<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Transactions & Bookings - Admin - MEGATERRA</title>
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/pages/admin-dashboard.css" />
  </head>
  <body>
    <%- include('../../partials/navbar') %>

    <main class="admin-main">
      <aside class="admin-sidebar">
        <ul class="admin-sidebar-nav">
          <li>
            <a
              href="#"
              class="<%= activeMenu === 'overview' ? 'active' : '' %>"
            >
              <i data-lucide="layout-dashboard"></i> Dashboard Overview
            </a>
          </li>
          <li>
            <a
              href="/admin/transactions"
              class="<%= activeMenu === 'transactions' ? 'active' : '' %>"
            >
              <i data-lucide="receipt"></i> Transactions & Bookings
            </a>
          </li>
          <li>
            <a
              href="/admin/cancel-requests"
              class="<%= activeMenu === 'cancel-requests' ? 'active' : '' %>"
            >
              <i data-lucide="x-circle"></i> Cancel Requests
            </a>
          </li>
          <li>
            <a
              href="/admin/reschedule-requests"
              class="<%= activeMenu === 'reschedule-requests' ? 'active' : '' %>"
            >
              <i data-lucide="calendar"></i> Reschedule Requests
            </a>
          </li>
        </ul>
      </aside>

      <!-- Main Content -->
      <section class="admin-content">
        <!-- Header row with Manual Entry button -->
        <div class="admin-header-row">
          <div class="admin-page-header">
            <h1 class="admin-page-title">Transactions & Bookings</h1>
          </div>
          <button type="button" class="btn-manual-entry">
            <i data-lucide="plus"></i> MANUAL ENTRY
          </button>
        </div>

        <!-- Filter Bar -->
        <form action="/admin/transactions" method="GET" class="admin-filter-bar">
          <!-- Search input -->
          <div class="admin-search-wrapper">
            <i data-lucide="search" class="admin-search-icon"></i>
            <input 
              type="text" 
              name="search" 
              value="<%= filters.search %>" 
              placeholder="Search booking ID, passenger, vendor..." 
              class="admin-search-input"
            />
          </div>

          <!-- Date Filter -->
          <div class="admin-filter-date">
            <i data-lucide="calendar" class="admin-filter-icon"></i>
            <input 
              type="date" 
              name="startDate" 
              value="<%= filters.startDate %>" 
              class="admin-date-input" 
              title="Start Date"
            />
            <span class="admin-date-sep">–</span>
            <input 
              type="date" 
              name="endDate" 
              value="<%= filters.endDate %>" 
              class="admin-date-input" 
              title="End Date"
            />
          </div>

          <!-- Status Select -->
          <div class="admin-select-wrapper">
            <select name="status" class="admin-filter-select" onchange="this.form.submit()">
              <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
              <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
              <option value="paid" <%= filters.status === 'paid' ? 'selected' : '' %>>Processing</option>
              <option value="disputed" <%= filters.status === 'disputed' ? 'selected' : '' %>>Disputed</option>
              <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
              <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            </select>
          </div>

          <!-- Reset Filter Button -->
          <a href="/admin/transactions" class="admin-btn-reset">
            <i data-lucide="rotate-ccw"></i> RESET
          </a>
        </form>

        <!-- Transactions Table -->
        <% if (transactions.length === 0) { %>
          <div class="admin-empty-state">
            <i data-lucide="inbox"></i>
            <p>No transactions found matching your criteria.</p>
          </div>
        <% } else { %>
          <div class="admin-table-card">
            <div class="table-scroll-wrapper">
              <table class="admin-table trx-table">
                <thead>
                  <tr>
                    <th>TRANSACTION</th>
                    <th>CUSTOMER</th>
                    <th>SERVICE</th>
                    <th>VENDOR</th>
                    <th>AMOUNT</th>
                    <th>STATUS</th>
                  </tr>
                </thead>
                <tbody>
                  <% transactions.forEach(tx => { %>
                    <tr>
                      <td class="trx-col-main">
                        <span class="trx-id">#TRX-<%= String(tx.id).padStart(5, '0') %></span>
                        <span class="trx-sub">
                          <%= new Date(tx.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>, 
                          <%= new Date(tx.created_at).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %> WIB
                        </span>
                      </td>

                      <td class="trx-col-main">
                        <span class="trx-name"><%= tx.customer_name || 'Guest User' %></span>
                        <span class="trx-sub"><%= tx.customer_email || '-' %></span>
                      </td>

                      <td class="trx-col-main">
                        <span class="trx-name"><%= tx.service_title || 'Travel Booking' %></span>
                        <span class="trx-sub"><%= tx.package_name %></span>
                      </td>

                      <td>
                        <span class="trx-vendor"><%= tx.vendor_name %></span>
                      </td>

                      <td class="trx-amount">
                        IDR <%= Number(tx.total_amount).toLocaleString('id-ID') %>
                      </td>

                      <td>
                        <% 
                          const st = (tx.status || 'pending').toLowerCase();
                          let badgeClass = 'status-pending';
                          let label = 'Pending';
                          if (st === 'completed') { badgeClass = 'status-completed'; label = 'Completed'; }
                          else if (st === 'paid') { badgeClass = 'status-processing'; label = 'Processing'; }
                          else if (st === 'disputed') { badgeClass = 'status-disputed'; label = 'Disputed'; }
                          else if (st === 'cancelled') { badgeClass = 'status-cancelled'; label = 'Cancelled'; }
                        %>
                        <span class="trx-status-badge <%= badgeClass %>">
                          <span class="status-dot"></span>
                          <%= label %>
                        </span>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

          <footer class="table-pagination-row">
              <div class="trx-footer-left">
                <div class="trx-limit-picker">
                  <label for="limitSelect" class="trx-limit-label">Show:</label>
                  <select 
                    id="limitSelect" 
                    class="trx-limit-select"
                    onchange="window.location.href='?page=1&limit=' + this.value + '&search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>'"
                  >
                    <option value="25" <%= pagination.limit === 25 ? 'selected' : '' %>>25 rows</option>
                    <option value="50" <%= pagination.limit === 50 ? 'selected' : '' %>>50 rows</option>
                    <option value="100" <%= pagination.limit === 100 ? 'selected' : '' %>>100 rows</option>
                  </select>
                </div>

                <span class="pagination-info">
                  Showing <%= ((pagination.currentPage - 1) * pagination.limit) + 1 %>–<%= Math.min(pagination.currentPage * pagination.limit, pagination.totalCount) %> of <%= pagination.totalCount.toLocaleString('id-ID') %> entries
                </span>
              </div>

              <% if (pagination.totalPages > 1) { %>
                <nav class="pagination-controls">
                  <% if (pagination.currentPage > 1) { %>
                    <a href="?page=<%= pagination.currentPage - 1 %>&limit=<%= pagination.limit %>&search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>" class="page-arrow" aria-label="Previous">
                      <i data-lucide="chevron-left"></i>
                    </a>
                  <% } %>
                  <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                    <% if (i === 1 || i === pagination.totalPages || (i >= pagination.currentPage - 1 && i <= pagination.currentPage + 1)) { %>
                      <a 
                        href="?page=<%= i %>&limit=<%= pagination.limit %>&search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>" 
                        class="page-num <%= pagination.currentPage === i ? 'active' : '' %>"
                      >
                        <%= i %>
                      </a>
                    <% } else if (i === pagination.currentPage - 2 || i === pagination.currentPage + 2) { %>
                      <span class="page-ellipsis">...</span>
                    <% } %>
                  <% } %>

                  <% if (pagination.currentPage < pagination.totalPages) { %>
                    <a href="?page=<%= pagination.currentPage + 1 %>&limit=<%= pagination.limit %>&search=<%= encodeURIComponent(filters.search) %>&status=<%= filters.status %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>" class="page-arrow" aria-label="Next">
                      <i data-lucide="chevron-right"></i>
                    </a>
                  <% } %>
                </nav>
              <% } %>
            </footer>
          </div>    
        <% } %>
      </section> 
    </main>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/loginModal') %>
  </body>
</html>
