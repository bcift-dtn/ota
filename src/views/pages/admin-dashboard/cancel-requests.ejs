<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cancel Requests - Admin - MEGATERRA</title>
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/pages/admin-dashboard.css" />
  </head>

  <body>
    <%- include('../../partials/navbar') %>

    <main class="admin-main">
      <aside class="admin-sidebar">
        <div class="admin-sidebar-logo">
          <span>Admin Panel</span>
        </div>
        <ul class="admin-sidebar-nav">
          <li>
            <a
              href="#"
              class="<%= activeMenu === 'overview' ? 'active' : '' %>"
            >
              <i data-lucide="layout-dashboard"></i> Dashboard Overview
            </a>
          </li>
          <li>
            <a
              href="/admin/cancel-requests"
              class="<%= activeMenu === 'cancel-requests' ? 'active' : '' %>"
            >
              <i data-lucide="x-circle"></i> Cancel Requests
            </a>
          </li>
        </ul>
      </aside>

      <section class="admin-content">
        <div class="admin-page-header">
          <h1 class="admin-page-title">Cancel Requests</h1>
          <span class="admin-badge-count"><%= requests.length %> Pending</span>
        </div>

         <% if (requests.length === 0) { %>
          <div class="admin-empty-state">
            <i data-lucide="inbox"></i>
            <p>No pending cancellation requests.</p>
          </div>
        <% } else { %> 
            <div class="admin-table-wrapper">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Order</th>
                  <th>Customer</th>
                  <th>Product</th>
                  <th>Total Paid</th>
                  <th>Cancel Fee</th>
                  <th>Refund Amount</th>
                  <th>Reason</th>
                  <th>Requested</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% requests.forEach(cancelReq => { %>
                  <tr>
                    <td>
                      <span class="admin-order-id">#MT-<%= req.product_type.toUpperCase() %>-<%= req.order_id %></span>
                    </td>
                    <td>
                      <span class="admin-customer-name"><%= req.customer_name %></span>
                      <span class="admin-customer-email"><%= req.customer_email %></span>
                    </td>
                    <td><%= req.product_title %></td>
                    <td>IDR <%= Number(req.total_amount).toLocaleString('id-ID') %></td>
                    <td class="admin-fee-cell">IDR <%= Number(req.cancel_fee).toLocaleString('id-ID') %></td>
                    <td class="admin-refund-cell">IDR <%= Number(req.refund_amount).toLocaleString('id-ID') %></td>
                    <td class="admin-reason-cell"><%= req.reason || '—' %></td>
                    <td>
                      <%= new Date(req.requested_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </td>
                    <td class="admin-action-cell">
                      <form action="/admin/cancel-requests/<%= req.cancel_id %>/approve" method="POST" class="admin-action-form">
                        <button type="submit" class="btn-admin-approve">Approve</button>
                      </form>
                      <form action="/admin/cancel-requests/<%= req.cancel_id %>/reject" method="POST" class="admin-action-form">
                        <button type="submit" class="btn-admin-reject">Reject</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </main>

    <%- include('../../partials/footer') %>
    <%- include('../../partials/loginModal') %>
  </body>
</html>
