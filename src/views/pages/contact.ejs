<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Us - MEGATERRA</title>

    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/pages/contact.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/css/intlTelInput.css"
    />
  </head>
  <body>
    <%- include('../partials/navbar') %>

    <main class="contact-main">
      <!-- Hero banner -->
      <div class="contact-banner">
        <img
          src="/images/hero-banners/ranoh-hero.webp"
          alt="Contact Us Banner"
        />
      </div>

      <div class="contact-content-container">
        <div class="contact-grid">
          <!-- Contact Form Section -->
          <section class="contact-form-section">
            <h2>Contact Us</h2>
            <form id="contactForm">
              <div id="contactStatus" class="contact-status"></div>

              <div class="form-row-split">
                <div class="form-group">
                  <label for="name">Full Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Name"
                    required
                  />
                </div>

                <div class="form-group">
                  <label for="email">Email Address</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="example@gmail.com"
                    required
                  />
                </div>
              </div>

              <div class="form-group">
                <label for="phone">Phone Number</label>
                <input
                  type="tel"
                  id="phone"
                  name="e.g. +628123456789"
                  required
                />
              </div>

              <div class="form-group">
                <label for="subject">Subject</label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  placeholder="Your Subject"
                  required
                />
              </div>

              <div class="form-group">
                <label for="message">Your Message</label>
                <textarea
                  name="message"
                  id="message"
                  placeholder="Your Message"
                  rows="6"
                  required
                ></textarea>
              </div>

              <button type="submit" class="submit-btn" id="submitBtn">
                Submit <i data-lucide="send"></i>
              </button>
            </form>
          </section>

          <!-- Quick Connect Side Panel -->
          <aside class="quick-connect-section">
            <div class="quick-connect-card">
              <h3>Quick Connect</h3>
              <div class="connect-items">
                <div class="connect-item">
                  <div class="icon-circle">
                    <i data-lucide="phone"></i>
                  </div>
                  <div>
                    <p class="connect-label">Call Us</p>
                    <p class="connect-value">+62 00000000</p>
                  </div>
                </div>
                <div class="connect-item">
                  <div class="icon-circle">
                    <i data-lucide="mail"></i>
                  </div>
                  <div>
                    <p class="connect-label">Email Support</p>
                    <p class="connect-value">support@gmail.com</p>
                  </div>
                </div>
                <div class="connect-item">
                  <div class="icon-circle">
                    <i data-lucide="map-pin"></i>
                  </div>
                  <div>
                    <p class="connect-label">Main Office</p>
                    <p class="connect-value">Main Office Address</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="map-card">
              <div class="map">
                <div class="map-marker">
                  <i data-lucide="map-pin"></i>
                </div>
              </div>
            </div>
          </aside>
        </div>

        <section class="faq-section">
          <p class="faq-subtitle">ASSISTANCE</p>
          <h2>Frequently Asked Questions</h2>

          <div class="faq-accordion-container">
            <div class="faq-item">
              <button class="faq-question" type="button">
                <span>How do i modify my booking?</span>
                <i data-lucide="plus" class="faq-icon"></i>
              </button>

              <div class="faq-answer">
                <div class="faq-answer-content">
                  <p>
                    Changes can be made through our portal or by contacting your
                    dedicated travel concierge directly.
                  </p>
                </div>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button">
                <span>Is travel insurance included?</span>
                <i data-lucide="plus" class="faq-icon"></i>
              </button>
              <div class="faq-answer">
                <div class="faq-answer-content">
                  <p>
                    We offer premium comprehensive travel insurance as an
                    optional add-on for all international itineraries
                  </p>
                </div>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button">
                <span>What is the refund policy?</span>
                <i data-lucide="plus" class="faq-icon"></i>
              </button>

              <div class="faq-answer">
                <div class="faq-answer-content">
                  <p>
                    Refunds vary by provider, but our standard flexible
                    cancellation window is 48 hours before departure.
                  </p>
                </div>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" type="button">
                <span>Do you offer group discounts?</span>
                <i data-lucide="plus" class="faq-icon"></i>
              </button>
              <div class="faq-answer">
                <div class="faq-answer-content">
                  <p>
                    Yes, corporate groups of 10 or more qualify for our
                    exclusive Enterprise Preferred Rates.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>
    </main>

    <%- include('../partials/footer') %> <%- include('../partials/loginModal')
    %>

    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@23.0.4/build/js/intlTelInput.min.js"></script>
    <script src="/js/contact.js"></script>
  </body>
</html>
